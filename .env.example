# Copie para .env e preencha antes de rodar `docker compose up`.
# .env é ignorado pelo git — nunca commitar segredos reais aqui.

# Obrigatório: chave HS256 do JWT, mínimo 32 caracteres.
JWT_SECRET=

# Opcional: e-mails com direito a Role.Admin no registro (separados por vírgula).
ADMIN_EMAILS=

# Opcional: sync agendado da Scryfall (default: true, a cada 24h).
SCRYFALL_SCHEDULED_SYNC_ENABLED=true
SCRYFALL_SYNC_INTERVAL_HOURS=24
