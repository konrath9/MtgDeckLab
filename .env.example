# Copie para .env e preencha antes de rodar `docker compose up`.
# .env é ignorado pelo git — nunca commitar segredos reais aqui.

# Obrigatório: chave HS256 do JWT, mínimo 32 caracteres.
JWT_SECRET=

# Opcional: e-mails com direito a Role.Admin no registro (separados por vírgula).
ADMIN_EMAILS=

# Opcional: sync agendado da Scryfall (default: true, a cada 24h).
SCRYFALL_SCHEDULED_SYNC_ENABLED=true
SCRYFALL_SYNC_INTERVAL_HOURS=24

# Opcional: sync dos nomes traduzidos das cartas (bulk multilíngue da Scryfall, vários GB).
# Desligado por default; ligue quando quiser buscar cartas pelo nome em português.
SCRYFALL_TRANSLATIONS_ENABLED=false
SCRYFALL_TRANSLATIONS_LANGUAGES=pt
SCRYFALL_TRANSLATIONS_SYNC_INTERVAL_HOURS=168

# Opcional: idiomas atendidos pela API (o primeiro/DefaultCulture vale quando o navegador
# não pede nenhum idioma que a gente atenda).
LOCALIZATION_DEFAULT_CULTURE=en-US
LOCALIZATION_SUPPORTED_CULTURES=en-US,pt-BR
